<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "programs" (desktop/README.md, "Code signing"): Stenny's own two programs, before
     they go into the setup program. CI's installer job sends them as one GitHub artifact (a zip) with these names and
     the app's version as the `version` parameter. A copy of what is set in SignPath's project; SignPath uses its own. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true"/>
  </parameters>
  <zip-file>
    <pe-file path="Stenny.exe" product-name="Stenny" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
    <pe-file path="stenny-rec.exe" product-name="Stenny" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
