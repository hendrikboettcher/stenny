{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stenny",
  "version": "0.5.1",
  "identifier": "eu.stenny.Stenny",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "library",
        "title": "Stenny",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/Stenny.mcpb": "Stenny.mcpb"
    },
    "externalBin": [
      "binaries/stenny-rec",
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "locales/en.lproj/InfoPlist.strings",
        "Resources/de.lproj/InfoPlist.strings": "locales/de.lproj/InfoPlist.strings"
      },
      "hardenedRuntime": false
    }
  }
}
