<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- merged into Stenny.app's Info.plist by the Tauri bundler. No LSUIElement: Stenny is a Dock app, so the Dock
       knows it from the start and bounces it while it opens. stenny-agent, which reads this Info.plist too, keeps
       itself out of the Dock (setActivationPolicy(.prohibited), app/Sources/stenny-agent/main.swift). -->
  <!-- English and German (desktop/src/lib/locales): the system's own parts (permission prompts, the share menu)
       follow the system's language; the permission texts below in German: locales/de.lproj/InfoPlist.strings -->
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleLocalizations</key><array><string>en</string><string>de</string></array>
  <key>NSMicrophoneUsageDescription</key>
  <string>Stenny records lectures you start from its menu. Audio stays on this Mac; pausing turns the microphone off.</string>
  <key>NSCalendarsFullAccessUsageDescription</key>
  <string>Stenny looks for the lecture that's on now in your calendar, so you can start recording it with one click. Nothing is changed or sent anywhere.</string>
</dict>
</plist>
